{
    "name": "chrisreedio/api-amigo",
    "description": "API Quota Management and Analytics",
    "keywords": [
        "chrisreedio",
        "laravel",
        "api-amigo"
    ],
    "homepage": "https://github.com/chrisreedio/api-amigo",
    "support": {
        "issues": "https://github.com/chrisreedio/api-amigo/issues",
        "source": "https://github.com/chrisreedio/api-amigo"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Chris Reed",
            "email": "chris@reedtech.io",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0",
        "flowframe/laravel-trend": "^0.4.0",
        "laravel/sanctum": "^3.3|^4.0",
        "saloonphp/saloon": "^3.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/shiki-php": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^7.9|^8.0",
        "orchestra/testbench": "^8.14|^9.0",
        "pestphp/pest": "^3",
        "pestphp/pest-plugin-arch": "^3",
        "pestphp/pest-plugin-laravel": "^3",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ChrisReedIO\\APIAmigo\\": "src/",
            "ChrisReedIO\\APIAmigo\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisReedIO\\APIAmigo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ChrisReedIO\\APIAmigo\\APIAmigoServiceProvider"
            ],
            "aliases": {
                "APIAmigo": "ChrisReedIO\\APIAmigo\\Facades\\APIAmigo"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}